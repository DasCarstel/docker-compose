# =====================================================================
# Headscale – Beispielkonfiguration fuer .env
# ---------------------------------------------------------------------
# Inbetriebnahme:
#   cp .env.example .env
#   chmod 600 .env
#   Werte unten ersetzen, dann: docker compose up -d
#
# Diese Variablen ueberschreiben die Werte aus
# /etc/docker/headscale/config/config.yaml (Headscale-Prefix HEADSCALE_).
# =====================================================================

# OAuth2-Client aus Authentik
# Authentik -> Applications -> "headscale" -> Provider ansehen
HEADSCALE_OIDC_CLIENT_ID=headscale
HEADSCALE_OIDC_CLIENT_SECRET=BITTE_ERSETZEN_128_zeichen_aus_authentik

# Issuer-URL des Authentik-Providers (endet auf /application/o/<slug>/)
HEADSCALE_OIDC_ISSUER=https://auth.mueller-nas.de/application/o/headscale/

# Oeffentliche URL des Control-Servers.
# Muss exakt der URL entsprechen, die Clients als --login-server verwenden,
# sonst schlaegt die Registrierung fehl.
HEADSCALE_SERVER_URL=https://headscale.mueller-nas.de
