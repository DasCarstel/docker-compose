# =====================================================================
# Jellyfin-Proxy – Beispielkonfiguration fuer .env
# ---------------------------------------------------------------------
# Inbetriebnahme:
#   cp .env.example .env
#   chmod 600 .env
#
# Der Key wird nur beim ERSTEN Start benoetigt (Enrollment des Nodes).
# Danach liegt der Node-State in /etc/docker/jellyfin-proxy/ts und der
# Key kann aus der .env entfernt werden.
# =====================================================================

# Reusable Preauth-Key erzeugen (auf dem Docker-Host):
#   docker exec headscale headscale preauthkeys create --user 2 --expiration 720h --reusable
# ("--user 2" = User "infra"; User-ID mit "headscale users list" pruefen)
TS_AUTHKEY=hskey-auth-BITTE_ERSETZEN
