# receipt-wrangler-mcp Umgebung (Datei auf dem Host als .env anlegen, Werte setzen)

# Basis-URL zu Receipt Wrangler (im Host-Netz: Containername + interner Port)
RW_BASE_URL=http://receipt-wrangler:80

# Receipt Wrangler API-Key (read-only, Scope 'r') - Pflicht
RW_API_TOKEN=

# Bearer-Tokens für eingehende MCP-Aufrufe (Hermes), kommagetrennt - Pflicht
# Feld 'token' aus OpenBao secret/data/mcp/bons
BONS_MCP_TOKEN=
