# =====================================================================
# ddns-updater – Beispielkonfiguration fuer .env
# ---------------------------------------------------------------------
# Inbetriebnahme:
#   cp .env.example .env
#   chmod 600 .env
#
# CONFIG hat Vorrang vor /updater/data/config.json und wird als EINE
# Zeile JSON geschrieben. Zeilenumbrueche sind hier nicht erlaubt.
#
# Felder:
#   zone_identifier = Cloudflare Zone-ID (32 Hex-Zeichen, NICHT der Domainname)
#                     ermitteln: curl -s -H "Authorization: Bearer $CF_TOKEN" \
#                       "https://api.cloudflare.com/client/v4/zones?name=mueller-nas.de"
#   domain          = A-Record, der auf die WAN-IP zeigen soll
#   ttl             = 60 (Minimum im Free-Plan)
#   proxied         = false  -> DNS-only, sonst terminiert Cloudflare die
#                     Verbindung und Port 443 erreicht den Edge-Proxy nie
#   ip_version      = ipv4
#   token           = Cloudflare-API-Token mit Zone:DNS:Edit
# =====================================================================

CONFIG={"settings":[{"provider":"cloudflare","zone_identifier":"BITTE_32_HEX_ZONE_ID","domain":"headscale.mueller-nas.de","ttl":60,"proxied":false,"ip_version":"ipv4","token":"BITTE_CLOUDFLARE_API_TOKEN"}]}
