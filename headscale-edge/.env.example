# =====================================================================
# Headscale-Edge (Traefik) – Beispielkonfiguration fuer .env
# ---------------------------------------------------------------------
# Inbetriebnahme:
#   cp .env.example .env
#   chmod 600 .env
#
# Der Token wird nur fuer die DNS-01-Challenge (Wildcard-Zertifikat)
# benoetigt. Er braucht exakt die Berechtigung Zone -> DNS -> Edit
# fuer die Zone mueller-nas.de. Kein "Zone:Read" auf alle Zonen.
# =====================================================================

CF_DNS_API_TOKEN=BITTE_CLOUDFLARE_API_TOKEN_MIT_ZONE_DNS_EDIT
